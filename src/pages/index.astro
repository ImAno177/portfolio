    page: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><path d="M8 2 h11 l5 5 v23 h-16 z" fill="#fff" stroke="#404040"/><path d="M19 2 v5 h5" fill="#dfdfdf" stroke="#404040" stroke-width="1"/><rect x="11" y="11" width="10" height="1" fill="#808080"/><rect x="11" y="14" width="10" height="1" fill="#808080"/><rect x="11" y="17" width="10" height="1" fill="#808080"/><rect x="11" y="20" width="7" height="1" fill="#808080"/></svg>',
    mail: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><rect x="3" y="7" width="26" height="18" fill="#fff" stroke="#404040"/><path d="M3 7 l13 9 13-9" fill="none" stroke="#808080" stroke-width="1"/><path d="M3 25 l9-7 M29 25 l-9-7" stroke="#dfdfdf" stroke-width="1"/></svg>',
