<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Duong Bach Chi — ImAno177</title>
<meta name="description" content="Portfolio of Duong Bach Chi — cloud security, Web3 security, Android security, program analysis.">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<!-- Wallpaper: ghibli-hill.svg — hand-drawn pastoral scene, no external assets -->
<style is:global>
  /* ---------- base ---------- */
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    overflow: hidden;
    font-family: "MS Sans Serif", Tahoma, Verdana, Geneva, sans-serif;
    font-size: 11px;
    color: #000;
    -webkit-tap-highlight-color: transparent;
  }
  :root { --task-h: 32px; }
  button { font: inherit; color: inherit; }
  a { color: #0000ee; }
  a:focus-visible, button:focus-visible {
    outline: 1px dotted #000;
    outline-offset: -3px;
  }

  /* ---------- bevels ---------- */
  .raised {
    background: #c0c0c0;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
                inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .sunken {
    background: #fff;
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
                inset -2px -2px #dfdfdf, inset 2px 2px #808080;
  }
  .btn {
    background: #c0c0c0;
    border: 0;
    padding: 4px 14px;
    cursor: default;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
                inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .btn:active, .btn.pressed {
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
                inset -2px -2px #dfdfdf, inset 2px 2px #808080;
    padding: 5px 13px 3px 15px;
  }

  /* ---------- desktop : Ghibli-style hill scene ---------- */
  #desktop {
    position: fixed;
    inset: 0 0 var(--task-h) 0;
    background: #5a8fd0 center / cover no-repeat;
    overflow: hidden;
  }
  #icons {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 18px;
    padding: 14px 10px;
  }
  .icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    width: 78px;
    padding: 4px 2px;
    background: none;
    border: 0;
    color: #fff;
    text-align: center;
    cursor: default;
    user-select: none;
    -webkit-user-select: none;
  }
  .icon .ico { width: 32px; height: 32px; display: block; }
  .icon .lbl {
    padding: 1px 3px;
    line-height: 1.25;
    overflow-wrap: break-word;
    text-shadow: 1px 1px 0 rgba(0,0,0,.85);
  }
  .icon.selected .lbl { background: #000080; text-shadow: none; outline: 1px dotted #fff; outline-offset: -1px; }
  .icon:focus-visible { outline: none; }
  .icon:focus-visible .lbl { outline: 1px dotted #fff; outline-offset: 1px; background: #000080; text-shadow: none; }
  .icon.dragging { z-index: 2000; }

  /* ---------- windows ---------- */
  .win {
    position: absolute;
    display: flex;
    flex-direction: column;
    min-width: 220px;
    max-width: calc(100vw - 8px);
    max-height: calc(100dvh - var(--task-h) - 6px);
    background: #c0c0c0;
    padding: 3px;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #dfdfdf,
                inset -2px -2px #808080, inset 2px 2px #fff;
  }
  .win[hidden], .win.min { display: none; }
  .win.max {
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
    height: calc(100dvh - var(--task-h)) !important;
    max-height: none;
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 20px;
    padding: 0 2px 0 3px;
    background: linear-gradient(90deg, #000080, #1084d0);
    color: #fff;
    font-weight: 700;
    letter-spacing: .02em;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }
  .win:not(.active) .titlebar { background: linear-gradient(90deg, #808080, #b5b5b5); color: #e8e8e8; }
  .tb-icon { width: 16px; height: 16px; flex: none; }
  .tb-title { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tb-btns { display: flex; gap: 2px; }
  .tb-btn {
    width: 16px;
    height: 14px;
    padding: 0;
    background: #c0c0c0;
    border: 0;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
                inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .tb-btn svg { display: block; }
  .tb-btn:active {
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
                inset -2px -2px #dfdfdf, inset 2px 2px #808080;
  }
  .menubar {
    display: flex;
    gap: 2px;
    padding: 2px 0;
  }
  .menubar span { padding: 2px 7px; }
  .menubar span:hover { box-shadow: inset 1px 1px #fff, inset -1px -1px #808080; }
  .menubar span:first-letter { text-decoration: underline; }
  .win-body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 10px;
  }
  .win-body.paper { font-family: Consolas, "Courier New", monospace; }
  .statusbar {
    display: flex;
    gap: 2px;
    padding-top: 2px;
  }
  .status-cell {
    flex: 1;
    padding: 2px 6px;
    color: #222;
    box-shadow: inset 1px 1px #808080, inset -1px -1px #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .status-cell.r { flex: 0 1 auto; }

  /* welcome */
  #w-welcome h1 { margin: 0; font-size: 22px; letter-spacing: .02em; }
  #w-welcome .who { margin: 0 0 8px; color: #404040; }
  #w-welcome .tag { margin: 0 0 10px; font-style: italic; }
  #w-welcome .quick { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .quick .btn { display: inline-flex; align-items: center; gap: 6px; }
  .quick .ico { width: 16px; height: 16px; }
  hr.sep { border: 0; border-top: 1px solid #808080; border-bottom: 1px solid #fff; margin: 10px 0; }

  /* projects folder */
  .filelist { margin: 0; padding: 0; list-style: none; }
  .file-row {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 4px 10px;
    align-items: start;
    width: 100%;
    padding: 8px 6px;
    color: #000;
    text-decoration: none;
    font: inherit;
    text-align: left;
    background: none;
    border: 0;
    border-bottom: 1px solid #e8e8e8;
    cursor: default;
  }
  .file-row:hover { background: #eef4fb; }
  .file-row:focus-visible { outline: 1px dotted #000; outline-offset: -1px; background: #000080; color: #fff; }
  .file-row:focus-visible .desc, .file-row:focus-visible .meta { color: #d8e4f8; }
  .file-row .ico { width: 32px; height: 32px; grid-row: span 2; }
  .file-row .name { font-weight: 700; }
  .file-row .meta { color: #606060; margin-left: 6px; font-weight: 400; }
  .file-row .desc { grid-column: 2; color: #404040; }
  .file-row .pin { color: #8a6d1a; font-weight: 400; }

  /* certificates explorer */
  .certgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .cert-tile {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px;
    background: #c0c0c0;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: default;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
                inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .cert-tile:active {
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
                inset -2px -2px #dfdfdf, inset 2px 2px #808080;
  }
  .cert-tile:hover .ct-name { color: #000080; }
  .cert-tile:focus-visible { outline: 1px dotted #000; outline-offset: -4px; }
  .cert-tile img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    display: block;
    background: #fff;
    border: 1px solid #808080;
  }
  .cert-tile .ct-name { font-weight: 700; color: #000; line-height: 1.25; }
  .cert-tile .ct-issuer { color: #404040; }

  /* photo viewer */
  .viewer .win-body { padding: 6px; display: flex; flex-direction: column; }
  .pv-stage {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 8px;
    background: #808080;
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
                inset -2px -2px #dfdfdf, inset 2px 2px #404040;
  }
  .pv-stage img {
    height: min(52vh, 560px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    background: #fff;
    border: 1px solid #0a0a0a;
  }
  .pv-cap { padding: 6px 8px 2px; }
  .pv-cap .pv-title { font-weight: 700; margin: 0 0 2px; }
  .pv-cap .pv-sub { color: #303030; margin: 0; }
  .pv-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 2px 0;
  }
  .pv-bar .pv-pos { min-width: 34px; text-align: center; }
  .pv-bar .pv-gap { margin-left: auto; }
  .pv-bar .btn { text-decoration: none; }

  /* notepad-ish bodies */
  .paper h2 { font-size: 12px; margin: 0 0 2px; }
  .paper .rule { color: #808080; margin: 6px 0; }
  .paper p { margin: 0 0 6px; }

  /* mail */
  .field { display: grid; grid-template-columns: 62px 1fr; align-items: center; gap: 6px; margin-bottom: 4px; }
  .field label { text-align: right; color: #404040; }
  .field .val {
    padding: 3px 6px;
    overflow-wrap: anywhere;
    box-shadow: inset 1px 1px #0a0a0a, inset -1px -1px #fff,
                inset 2px 2px #808080, inset -2px -2px #dfdfdf;
    background: #fff;
  }
  .mail-actions { display: flex; gap: 8px; margin-top: 10px; }
  .mail-actions .btn { text-decoration: none; }

  /* welcome avatar */
  .who-row { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .avatar { width: 64px; height: 64px; padding: 3px; flex: none; }

  /* repo viewer windows */
  .repo-card { background: #fff; padding: 8px 10px 9px; }
  .rc-top { display: flex; align-items: center; gap: 7px; }
  .rc-top .ico { width: 16px; height: 16px; }
  .rc-top b { color: #0969da; font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rc-badge { margin-left: auto; flex: none; padding: 0 7px; border: 1px solid #808080; border-radius: 9px; font-size: 10px; color: #404040; }
  .rc-meta { display: flex; align-items: center; gap: 5px; margin-top: 5px; color: #57606a; }
  .rc-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; border: 1px solid #00000022; }
  .repo-head { display: flex; align-items: center; gap: 8px; margin: 10px 0 2px; }
  .repo-head h3 { margin: 0; font-size: 15px; }
  .repo-head img { width: 30px; height: 30px; object-fit: contain; }
  .repo-desc { margin: 0 0 4px; }
  .repo-detail { margin: 0 0 8px; color: #404040; }
  .repo-meta { display: grid; grid-template-columns: 74px 1fr; gap: 3px 10px; margin: 8px 0; }
  .repo-meta dt { color: #606060; }
  .repo-meta dd { margin: 0; }
  .repo-topics { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0; }
  .repo-topics span { padding: 1px 6px; background: #dfdfdf; box-shadow: inset 1px 1px #fff, inset -1px -1px #808080; }
  .repo-shots { display: flex; gap: 6px; margin: 8px 0; }
  .repo-shots img { width: 31%; border: 1px solid #808080; display: block; }
  .repo-arch { display: inline-block; padding: 1px 6px; background: #ffd867; box-shadow: inset 1px 1px #fff, inset -1px -1px #8a6d1a; }

  /* ---------- taskbar ---------- */
  #taskbar {
    position: fixed;
    inset: auto 0 0 0;
    height: var(--task-h);
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 4px;
    background: #c0c0c0;
    box-shadow: inset 0 1px #dfdfdf, inset 0 2px #fff;
    z-index: 5000;
  }
  #startbtn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 8px 0 5px;
    font-weight: 700;
    flex: none;
  }
  #startbtn .ico { width: 18px; height: 16px; }
  #taskbtns {
    flex: 1;
    display: flex;
    gap: 3px;
    min-width: 0;
    overflow: hidden;
  }
  .taskbtn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 1 160px;
    min-width: 0;
    height: 24px;
    padding: 0 8px;
    text-align: left;
    white-space: nowrap;
  }
  .taskbtn .ico { width: 16px; height: 16px; flex: none; }
  .taskbtn .t { overflow: hidden; text-overflow: ellipsis; }
  .taskbtn.on {
    font-weight: 700;
    box-shadow: inset -1px -1px #fff, inset 1px 1px #0a0a0a,
                inset -2px -2px #dfdfdf, inset 2px 2px #808080;
    background-image:
      linear-gradient(45deg, rgba(255,255,255,.45) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.45) 75%),
      linear-gradient(45deg, rgba(255,255,255,.45) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.45) 75%);
    background-size: 2px 2px;
    background-position: 0 0, 1px 1px;
  }
  #tray {
    flex: none;
    height: 24px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 6px;
    margin-right: 2px;
    box-shadow: inset 1px 1px #808080, inset -1px -1px #fff;
  }
  #tray .ico { width: 14px; height: 14px; display: block; }
  #clock {
    flex: none;
    height: 24px;
    display: grid;
    place-items: center;
    padding: 0 10px;
    box-shadow: inset 1px 1px #808080, inset -1px -1px #fff;
  }

  /* ---------- start menu ---------- */
  #startmenu {
    position: fixed;
    left: 2px;
    bottom: var(--task-h);
    display: flex;
    z-index: 6000;
    background: #c0c0c0;
    padding: 3px;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #dfdfdf,
                inset -2px -2px #808080, inset 2px 2px #fff;
  }
  #startmenu[hidden] { display: none; }
  .sm-banner {
    width: 24px;
    background: linear-gradient(180deg, #1084d0, #000080);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 6px 0;
  }
  .sm-banner span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: #c0c0c0;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: .06em;
  }
  .sm-banner b { color: #fff; font-weight: 700; }
  .sm-items { display: flex; flex-direction: column; min-width: 172px; }
  .sm-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 22px 6px 8px;
    border: 0;
    background: none;
    text-align: left;
    white-space: nowrap;
    color: #000;
    text-decoration: none;
  }
  .sm-item .ico { width: 20px; height: 20px; flex: none; }
  .sm-item:hover, .sm-item:focus-visible { background: #000080; color: #fff; outline: none; }
  .sm-sep { height: 0; margin: 3px 2px; border-top: 1px solid #808080; border-bottom: 1px solid #fff; }

  /* ---------- shutdown ---------- */
  #shutdown {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #000;
    color: #ff7f27;
    display: grid;
    place-items: center;
    text-align: center;
    font-family: Consolas, "Courier New", monospace;
    font-size: clamp(15px, 4.5vw, 22px);
    padding: 20px;
  }
  #shutdown[hidden] { display: none; }
  #shutdown small { display: block; margin-top: 18px; color: #7a4015; font-size: 12px; }

  /* ---------- win95 scrollbars ---------- */
  .win * { scrollbar-color: #c0c0c0 #dfdfdf; scrollbar-width: auto; }
  .win ::-webkit-scrollbar { width: 16px; height: 16px; }
  .win ::-webkit-scrollbar-track {
    background: repeating-conic-gradient(#dfdfdf 0% 25%, #fff 0% 50%) 0 0 / 2px 2px;
  }
  .win ::-webkit-scrollbar-thumb {
    background: #c0c0c0;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
                inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .win ::-webkit-scrollbar-button {
    width: 16px;
    height: 16px;
    background-color: #c0c0c0;
    background-repeat: no-repeat;
    background-position: center;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff,
                inset -2px -2px #808080, inset 2px 2px #dfdfdf;
  }
  .win ::-webkit-scrollbar-button:vertical:decrement {
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3E%3Cpath d='M4 2.5 7 6.5H1z' fill='black'/%3E%3C/svg%3E");
  }
  .win ::-webkit-scrollbar-button:vertical:increment {
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3E%3Cpath d='M4 5.5 1 1.5h6z' fill='black'/%3E%3C/svg%3E");
  }
  .win ::-webkit-scrollbar-button:horizontal:decrement {
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3E%3Cpath d='M2.5 4 6.5 1v6z' fill='black'/%3E%3C/svg%3E");
  }
  .win ::-webkit-scrollbar-button:horizontal:increment {
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3E%3Cpath d='M5.5 4 1.5 1v6z' fill='black'/%3E%3C/svg%3E");
  }
  .win ::-webkit-scrollbar-corner { background: #c0c0c0; }

  /* ---------- marquee selection ---------- */
  .marquee {
    position: absolute;
    border: 1px dotted #000;
    background: rgba(255,255,255,.18);
    z-index: 3000;
    pointer-events: none;
  }

  /* ---------- ghost outline while moving a window ---------- */
  .drag-ghost {
    position: fixed;
    border: 2px solid #fff;
    mix-blend-mode: difference;
    z-index: 4000;
    pointer-events: none;
  }

  /* ---------- resize grip ---------- */
  .resize-grip {
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 14px;
    height: 14px;
    cursor: nwse-resize;
    z-index: 5;
    touch-action: none;
    background:
      linear-gradient(135deg, transparent 0 9px, #808080 9px 10px, #fff 10px 11px, transparent 11px),
      linear-gradient(135deg, transparent 0 5px, #808080 5px 6px, #fff 6px 7px, transparent 7px),
      linear-gradient(135deg, transparent 0 1px, #808080 1px 2px, #fff 2px 3px, transparent 3px);
  }
  .win.max .resize-grip { display: none; }

  /* ---------- desktop context menu ---------- */
  .ctxmenu {
    position: fixed;
    z-index: 6500;
    background: #c0c0c0;
    padding: 2px;
    min-width: 148px;
    box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #dfdfdf,
                inset -2px -2px #808080, inset 2px 2px #fff;
  }
  .ctxmenu[hidden] { display: none; }
  .ctxmenu .sm-item { padding: 4px 18px 4px 10px; width: 100%; }
  #desktop.refresh { filter: brightness(1.07); }
  #icons.abs .icon { position: absolute; margin: 0; }

  /* ---------- display properties dialog ---------- */
  .dtabs { display: flex; margin-bottom: -2px; position: relative; z-index: 1; }
  .dtab {
    padding: 4px 12px;
    background: #c0c0c0;
    border: 0;
    box-shadow: inset 1px 1px #fff, inset -1px -1px #808080;
  }
  .dtab.on { padding-bottom: 6px; box-shadow: inset 1px 1px #fff, inset -1px 0 #808080; font-weight: 700; }
  .dpanel { padding: 10px; }
  .dprev {
    width: 220px;
    margin: 0 auto 10px;
    padding: 3px;
    background: #fff;
  }
  .dprev img { display: block; width: 100%; }
  .dmeta { margin: 8px 0; color: #404040; }
  .dmeta b { color: #000; }
  .dactions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px; }

  /* ---------- small screens ---------- */
  @media (max-width: 600px) {
    .win:not(.max) { left: 6px !important; right: 6px; width: auto !important; }
    #icons { gap: 10px; }
    .icon { width: 68px; }
    .taskbtn { flex-basis: 120px; }
    .certgrid { grid-template-columns: 1fr; }
  }
  @media (max-width: 380px) {
    .taskbtn .t { display: none; }
    .taskbtn { flex: 0 0 auto; }
  }

  /* ---------- motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .win { animation: winpop .12s ease-out; }
    #startmenu { animation: menupop .1s ease-out; }
    @keyframes winpop { from { transform: scale(.97); opacity: .5; } }
    @keyframes menupop { from { transform: translateY(6px); opacity: .5; } }
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>
</head>
<body>

<main id="desktop" aria-label="Desktop" style="background-image: url('ghibli-hill.svg')">

