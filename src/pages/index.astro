---
import Layout from '../layouts/Layout.astro';
import {profile,projects,researchNotes,skillGroups} from '../data/portfolio';
import room from '../game/data/room.json';
import {CAT_SEEDS} from '../game/data/cats';
const base=import.meta.env.BASE_URL;
const links=['about','projects','research','cv','contact'];
---
<Layout title={`${profile.name} — a room with a view`} description={profile.summary}>
 <a class="skip-link" href="#about">Skip to portfolio</a>
 <div class="site-shell" data-base-path={base}>
  <header class="site-header">
   <a class="wordmark" href="#home">imano177<span> / room with a view</span></a>
   <nav aria-label="Portfolio">{links.map(id=><a href={`#${id}`}>{id==='cv'?'CV':id}</a>)}</nav>
   <a class="text-toggle" href="#text" data-text-toggle>Text version</a>
  </header>
  <main id="home">
   <section class="room-stage" aria-label="Interactive pixel-art cat room">
    <div class="room-caption"><span>PERSONAL STUDIO / 01</span><span data-room-time>Welcome in</span></div>
    <div class="room-viewport" data-room-viewport>
     <img class="room-fallback" src={`${base}assets/room/fallback.png`} width="640" height="360" alt="A pixel-art studio with a bookshelf and desk on the left, a sky-facing balcony, a central rug and a sofa on the right." />
     <div class="cat-room" data-cat-room-root></div>
     <div class="hotspot-layer" aria-label="Objects in the room">
      {room.hotspots.map(spot=><a class="hotspot" href={`#${spot.id}`} data-world-x={spot.x} data-world-y={spot.y} style={`left:${spot.x/6.4}%;top:${spot.y/3.6}%`} aria-label={spot.label}><span>{spot.label}</span></a>)}
      <a class="hotspot" href={profile.github} target="_blank" rel="noreferrer" data-world-x="188" data-world-y="148" style="left:29.375%;top:41.111%" aria-label="Desk notebook · GitHub"><span>GitHub ↗</span></a>
     </div>
    </div>
    <div class="room-toolbar">
     <p data-room-status role="status">The room is waking up…</p>
     <div class="room-buttons">
      <button data-retry hidden>Retry room</button>
      <button data-hotspot-toggle aria-pressed="false">Show places</button>
      <button data-pause-toggle aria-pressed="false">Pause room</button>
      <button data-motion-toggle aria-pressed="false">Gentle motion</button>
      <button data-fullscreen hidden>Enlarge</button>
     </div>
    </div>
   </section>
   <section class="cat-controls" aria-label="Cat controls">
    <label class="cat-picker">KEEP COMPANY WITH <select data-cat-select><option value="">Choose a cat</option>{CAT_SEEDS.map(cat=><option value={cat.id}>{cat.name}</option>)}</select></label>
    <div class="cat-actions">{['pet','feed','play','call'].map(action=><button data-cat-action={action} disabled>{action}</button>)}</div>
    <p data-selected-cat>Six small lives. Their own pace.</p>
    <p class="interaction-status" data-interaction-status role="status" aria-live="polite">Select a cat in the room or from the menu.</p>
   </section>
   <div id="text" class="portfolio-content" data-portfolio-content>
    <section id="about" class="content-section" tabindex="-1"><p class="eyebrow">WINDOW / 01</p><h1>Hi, I'm {profile.name}.</h1><p>{profile.summary}</p><p>I like inspectable systems, local-first tools, and a carefully riced desktop. This is my little place on the internet.</p><dl><dt>Focus</dt><dd>{profile.interests.join(' · ')}</dd><dt>At home with</dt><dd>{profile.languages.join(' / ')}</dd><dt>Workspace</dt><dd>{profile.habitat} · {profile.editor}</dd></dl><a href={`mailto:${profile.email}`}>Say hello ↗</a></section>
    <section id="projects" class="content-section" tabindex="-1"><p class="eyebrow">DESK / 02</p><h2>Things I've built.</h2>{projects.map(project=><article><small>{project.type}</small><h3><a href={project.href} target="_blank" rel="noreferrer">{project.title} ↗</a></h3><p>{project.description}</p><p class="tags">{project.tags.join(' / ')}</p></article>)}<a href={profile.github} target="_blank" rel="noreferrer">All repositories ↗</a></section>
    <section id="research" class="content-section" tabindex="-1"><p class="eyebrow">BOOKSHELF / 03</p><h2>Notes & investigations.</h2>{researchNotes.map(note=><article><small>{note.label}</small><h3>{note.title}</h3><p>{note.text}</p></article>)}</section>
    <section id="cv" class="content-section" tabindex="-1"><p class="eyebrow">NOTICE BOARD / 04</p><h2>Profile.</h2><p>{profile.role}</p><dl>{skillGroups.map(group=><div><dt>{group.label}</dt><dd>{group.values.join(' / ')}</dd></div>)}</dl><p>For the current CV and education history, get in touch directly.</p><a href={`mailto:${profile.email}?subject=CV%20request`}>Request CV ↗</a></section>
    <section id="contact" class="content-section" tabindex="-1"><p class="eyebrow">COFFEE TABLE / 05</p><h2>Pull up a chair.</h2><p>A question, an interesting project, or just a hello.</p><dl><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd><dt>Discord</dt><dd><code>{profile.discord}</code> <button data-copy-discord={profile.discord}>Copy username</button></dd><dt>GitHub</dt><dd><a href={profile.github} target="_blank" rel="noreferrer">github.com/ImAno177 ↗</a></dd><dt>Website</dt><dd><a href={profile.portfolio}>{profile.portfolio}</a></dd></dl><p data-copy-status role="status"></p></section>
   </div>
  </main>
  <footer><span>Cloud & Web3 security · local time, slow living</span><a href={`mailto:${profile.email}`}>{profile.email} ↗</a></footer>
 </div>
 <dialog class="content-dialog" aria-label="Portfolio information" data-content-dialog><button class="close-panel" data-panel-close autofocus aria-label="Close panel">Close ×</button><div data-panel-body></div></dialog>
 <noscript><p class="noscript-banner">The room is resting. All portfolio information and contact links are available above.</p><style>.room-toolbar,.cat-controls,.hotspot-layer{display:none}</style></noscript>
 <script>import {setupPortfolioUI} from '../client/portfolio-ui';setupPortfolioUI();</script>
</Layout>
