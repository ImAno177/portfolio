---
import Layout from '../layouts/Layout.astro';
import { profile, projects, skillGroups, certificates } from '../data/portfolio';
import '../styles/meadow.css';
const base = import.meta.env.BASE_URL;
const shortIssuer = (issuer: string) => issuer === 'British Standards Institution' ? 'BSI' : issuer;
---
<Layout title={`${profile.name} — a quiet study`} description={`A small, interactive room for things learned. Explore ${profile.name}'s certificates from IBM, Google and BSI, and the work behind them.`}>
  <a class="skip-link" href="#collection">Browse the certificates without using 3D</a>
  <div class="gallery-app" data-gallery-app data-base-path={base} data-time="day">
    <header class="gallery-header">
      <a class="gallery-brand" href="#room" aria-label="Return to the room"><svg viewBox="0 0 34 38" fill="none" aria-hidden="true"><path d="M5 33V8l12-5 12 5v25H5Z M17 3v30M5 17h24M11 33v-9h12v9" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M2 35h30" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><span>{profile.name}<small>A QUIET STUDY</small></span></a>
      <nav class="gallery-nav" aria-label="Portfolio navigation"><a href="#collection" data-collection-link>Collection <span class="collection-count">{certificates.length}</span></a><a href="#about">About</a><a href="#contact" class="gallery-contact-link">Say hello <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main>
      <section class="gallery-stage" id="room" data-gallery-stage data-scene-state="resting" aria-labelledby="room-title">
        <h1 id="room-title" class="visually-hidden">ImAno177’s study — a room for things learned</h1>
        <div class="gallery-fallback">
          <div class="fallback-window" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <div class="fallback-rail" aria-hidden="true"></div>
          <div class="fallback-frames">{certificates.map(certificate => <a class="fallback-frame" href={`#${certificate.id}`} aria-label={`View ${certificate.title}`}><img src={`${base}${certificate.image}`} width="1200" height="928" alt={`${certificate.title}, awarded to Duong Bach Chi by ${certificate.issuer}`} /><span>{shortIssuer(certificate.issuer)}</span></a>)}</div>
          <div class="fallback-cabinet" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="fallback-floor" aria-hidden="true"></div>
        </div>
        <div class="gallery-canvas" data-gallery-root tabindex="0" role="group" aria-label="Three-dimensional study. Drag or use the arrow keys to look around. Use the collection links to view each certificate."></div>
        <nav class="frame-hotspots" aria-label="Framed certificates">{certificates.map(certificate => <a href={`#${certificate.id}`} class="frame-hotspot" data-frame-link={certificate.id} aria-label={`View ${certificate.title}`}><span class="frame-dot" aria-hidden="true"></span><span class="frame-tooltip">{shortIssuer(certificate.issuer)} <span aria-hidden="true">↗</span></span></a>)}</nav>
        <div class="room-message"><p data-gallery-status role="status">An illustrated room. Choose a frame to see what’s inside.</p><button type="button" data-gallery-retry hidden>Try the 3D room again</button></div>
        <div class="room-introduction"><span class="room-eyebrow">A personal collection</span><p>Things learned.<br /><em>Kept close.</em></p><span class="room-invitation" data-room-hint>Three frames, each with a story.</span></div>
        <div class="gallery-bottom">
          <nav class="frame-index" aria-label="Choose a certificate"><span class="frame-index-label">ON THE WALL</span>{certificates.map((certificate, index) => <a href={`#${certificate.id}`} data-select-frame={certificate.id}><span class="frame-number">{String(index + 1).padStart(2, '0')}</span>{shortIssuer(certificate.issuer)}<span class="frame-index-arrow" aria-hidden="true">↗</span></a>)}</nav>
          <div class="gallery-controls" aria-label="Room settings" data-gallery-controls hidden>
            <button type="button" data-time-toggle aria-label="Evening light" aria-pressed="false"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3.4"/><path d="M10 1v2m0 14v2M1 10h2m14 0h2M3.6 3.6 5 5m10 10 1.4 1.4m0-12.8L15 5M5 15l-1.4 1.4"/></svg><span data-time-label>Afternoon</span></button>
            <button type="button" data-motion-toggle aria-label="Pause room motion" aria-pressed="false"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 4v12m6-12v12"/></svg><span data-motion-label>Pause</span></button>
            <button type="button" data-reset-view aria-label="Reset the room view" title="Reset the view"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 8a6.3 6.3 0 1 1 0 5m0-10v5h5"/></svg></button>
          </div>
        </div>
      </section>
      <div class="gallery-content" data-gallery-content>
        <section id="collection" class="gallery-panel" aria-labelledby="collection-heading">
          <p class="panel-eyebrow">On the wall</p><h2 id="collection-heading">A few things I’ve learned.</h2><p class="panel-intro">Three certificates, their original images, and a link to verify each one.</p>
          <div class="certificate-grid">{certificates.map((certificate, index) => <article class="certificate-record" id={certificate.id} data-certificate>
            <div class="certificate-art"><img class="certificate-image" src={`${base}${certificate.image}`} width="1200" height="928" loading="lazy" alt={`Original Coursera certificate: ${certificate.title}, awarded to Duong Bach Chi on ${certificate.date}`} /></div>
            <div class="certificate-information"><p class="panel-eyebrow">{shortIssuer(certificate.issuer)} <span aria-hidden="true">·</span> {certificate.kind}</p><h3 id={`${certificate.id}-heading`}>{certificate.title}</h3><p class="certificate-description">{certificate.description}</p><dl class="certificate-facts"><div><dt>Issued by</dt><dd>{certificate.issuer}</dd></div><div><dt>Completed</dt><dd><time datetime={certificate.issued}>{certificate.date}</time></dd></div><div><dt>Credential</dt><dd><code>{certificate.credentialId}</code></dd></div></dl><ul class="certificate-tags" aria-label="Topics">{certificate.tags.map(tag => <li>{tag}</li>)}</ul><div class="certificate-links"><a class="gallery-button" href={certificate.href} target="_blank" rel="noreferrer">Verify on Coursera <span aria-hidden="true">↗</span></a><a class="certificate-full-size" href={`${base}${certificate.image}`} target="_blank" rel="noreferrer">Open full-size image ↗</a><a href={`#${certificate.id}`} class="open-certificate" data-open-certificate>View frame <span aria-hidden="true">↗</span></a></div><span class="certificate-folio">{String(index + 1).padStart(2, '0')} / {String(certificates.length).padStart(2, '0')}</span></div>
          </article>)}</div><p class="collection-provenance">Certificate images and completion dates are from the linked Coursera records. These are course and program completion credentials, not university degrees.</p>
        </section>
        <section id="about" class="gallery-panel prose-panel" aria-labelledby="about-heading"><p class="panel-eyebrow">The person behind the frames</p><h2 id="about-heading">Hi, I’m {profile.name}.</h2><p>{profile.summary}</p><p>I like inspectable systems, local-first tools, and a carefully riced desktop. This room is a small place to keep what I’m learning.</p><dl class="gallery-skills">{skillGroups.map(group => <div><dt>{group.label}</dt><dd>{group.values.join(' / ')}</dd></div>)}</dl><h3>Elsewhere on my workbench</h3><ul class="gallery-project-links">{projects.map(project => <li><a href={project.href} target="_blank" rel="noreferrer"><span>{project.title}</span><span aria-hidden="true">↗</span></a><p>{project.description}</p></li>)}</ul><div class="about-links"><a href={`mailto:${profile.email}?subject=CV%20request`}>Request my current CV ↗</a></div></section>
        <section id="contact" class="gallery-panel prose-panel" aria-labelledby="contact-heading"><p class="panel-eyebrow">Pull up a chair</p><h2 id="contact-heading">Leave a little note.</h2><p>A question, an interesting project, or just a hello.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a><dl class="contact-details"><div><dt>GitHub</dt><dd><a href={profile.github} target="_blank" rel="noreferrer">ImAno177 ↗</a></dd></div><div><dt>Discord</dt><dd><code>{profile.discord}</code><button type="button" data-copy-discord={profile.discord} hidden>Copy username</button></dd></div></dl><p class="copy-feedback" data-copy-status role="status"></p></section>
      </div>
    </main>
    <dialog class="gallery-dialog" data-gallery-dialog aria-label="Collection details"><div class="gallery-dialog-bar"><a href="#collection" class="dialog-collection-link">The collection</a><button type="button" data-panel-close autofocus aria-label="Close and return to the room">Close <span aria-hidden="true">×</span></button></div><div data-panel-body></div><nav class="certificate-pagination" data-certificate-pagination aria-label="Browse certificates" hidden><button type="button" data-previous-certificate>← Previous frame</button><span data-certificate-position></span><button type="button" data-next-certificate>Next frame →</button></nav></dialog>
  </div>
  <noscript><p class="gallery-noscript">The illustrated edition works without JavaScript. All certificates and verification links are available below the room.</p></noscript>
  <script>import { setupGalleryPortfolio } from '../client/meadow-ui'; setupGalleryPortfolio();</script>
</Layout>
