    droid: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><rect x="7" y="10" width="18" height="14" rx="2" fill="#3ddc84" stroke="#1e7a4a"/><rect x="9" y="6" width="14" height="6" rx="3" fill="#3ddc84" stroke="#1e7a4a"/><rect x="11" y="8" width="2" height="2" fill="#fff"/><rect x="19" y="8" width="2" height="2" fill="#fff"/><path d="M10 4 l3 3 M22 4 l-3 3" stroke="#1e7a4a" stroke-width="1"/><rect x="4" y="12" width="3" height="9" fill="#3ddc84" stroke="#1e7a4a"/><rect x="25" y="12" width="3" height="9" fill="#3ddc84" stroke="#1e7a4a"/></svg>',
    shield: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><path d="M16 2 l12 4 v9 c0 8 -5 13 -12 15 c-7 -2 -12 -7 -12 -15 v-9 z" fill="#2d7cd6" stroke="#0a3a70"/><path d="M16 5 l9 3 v7 c0 6 -4 10 -9 12 z" fill="#7db8ec"/><path d="M10 15 l4 4 8 -8" fill="none" stroke="#fff" stroke-width="2"/></svg>',
    spider: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><rect x="12" y="12" width="8" height="8" fill="#404040"/><rect x="14" y="6" width="4" height="6" fill="#404040"/><path d="M12 12 l-8 -6 M12 15 l-10 -1 M12 18 l-10 2 M13 20 l-7 7 M20 12 l8 -6 M20 15 l10 -1 M20 18 l10 2 M19 20 l7 7" stroke="#404040" stroke-width="1"/><rect x="14" y="14" width="2" height="2" fill="#e0362c"/></svg>',
    globe: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><circle cx="16" cy="16" r="12" fill="#3aa6d0" stroke="#1a4a60"/><ellipse cx="16" cy="16" rx="5" ry="12" fill="none" stroke="#dff2f8" stroke-width="1"/><path d="M4.5 12 h23 M4.5 20 h23" stroke="#dff2f8" stroke-width="1"/></svg>',
    wrench: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><path d="M22 3 a7 7 0 0 0-8.7 8.7 L5 20 l6 6 8.3-8.3 A7 7 0 0 0 28 9 l-4.5 4.5 -3.5-.8 -.8-3.5 Z" fill="#909090" stroke="#404040"/></svg>',
    eye: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><ellipse cx="16" cy="16" rx="13" ry="8" fill="#fff" stroke="#404040"/><circle cx="16" cy="16" r="5" fill="#2d7cd6" stroke="#0a3a70"/><circle cx="16" cy="16" r="2" fill="#0a0a0a"/></svg>',
    eth: '<svg viewBox="0 0 32 32" shape-rendering="crispEdges" width="100%" height="100%"><path d="M16 3 L25 16 L16 21 L7 16 Z" fill="#8a9cf0" stroke="#3a4a80"/><path d="M16 22 L25 16 L16 29 L7 16 Z" fill="#5a6cb0" stroke="#3a4a80"/></svg>'
  };
  document.querySelectorAll("[data-ico]").forEach(function (el) {
    el.innerHTML = ICONS[el.getAttribute("data-ico")] || "";
    el.setAttribute("aria-hidden", "true");
  });

  /* ---------- window manager ---------- */
  var IDS = ["welcome", "projects", "certificates", "about", "contact", "display"];
  var taskbtns = document.getElementById("taskbtns");
  var zTop = 10;
  var activeId = null;
  var openWins = {};   /* id -> { el, btn, prevRect, opener } */

  function winEl(id) { return document.getElementById("w-" + id); }

  function centerWindow(el) {
    var deskH = window.innerHeight - 32; /* taskbar */
    var w = el.offsetWidth, h = el.offsetHeight;
    el.style.left = Math.max(4, Math.round((window.innerWidth - w) / 2)) + "px";
    el.style.top = Math.max(4, Math.round((deskH - h) / 2) - 6) + "px";
  }

  function focusWindow(id) {
    var rec = openWins[id];
    if (!rec) return;
    rec.el.classList.remove("min");
    rec.el.hidden = false;
    rec.el.style.zIndex = ++zTop;
    activeId = id;
    Object.keys(openWins).forEach(function (w) {
      var r = openWins[w];
      var on = w === id;
      r.el.classList.toggle("active", on);
      r.btn.classList.toggle("on", on);
      r.btn.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  function focusTop() {
    var best = null, bestZ = -1;
    Object.keys(openWins).forEach(function (id) {
      var r = openWins[id];
      if (r.el.classList.contains("min")) return;
      var z = parseInt(r.el.style.zIndex || "0", 10);
      if (z > bestZ) { bestZ = z; best = id; }
    });
    if (best) focusWindow(best); else activeId = null;
  }

  function openWindow(id, opener) {
    var el = winEl(id);
    if (!el) return;
    if (!openWins[id]) {
      var btn = document.createElement("button");
      btn.className = "btn taskbtn";
      btn.setAttribute("aria-pressed", "false");
      btn.innerHTML = '<span class="ico">' + el.querySelector(".tb-icon").innerHTML +
                      '</span><span class="t"></span>';
      btn.querySelector(".t").textContent = el.querySelector(".tb-title").textContent;
      btn.addEventListener("click", function () { toggleTask(id); });
      taskbtns.appendChild(btn);
      openWins[id] = { el: el, btn: btn, opener: opener || null };
      el.hidden = false;
      el.tabIndex = -1;
      centerWindow(el);
      el.style.zIndex = ++zTop;
    } else {
      openWins[id].el.classList.remove("min");
    }
    if (opener) openWins[id].opener = opener;
    focusWindow(id);
    el.focus({ preventScroll: true });
