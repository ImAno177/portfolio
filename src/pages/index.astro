    var m = document.createElement("div");
    m.className = "marquee";
    var started = false;
    function move(ev) {
      var x1 = Math.min(ox, ev.clientX), y1 = Math.min(oy, ev.clientY);
      var x2 = Math.max(ox, ev.clientX), y2 = Math.max(oy, ev.clientY);
      if (!started && x2 - x1 + y2 - y1 > 4) { desktop.appendChild(m); started = true; }
      if (!started) return;
      m.style.left = x1 - dr.left + "px";
      m.style.top = y1 - dr.top + "px";
      m.style.width = x2 - x1 + "px";
      m.style.height = y2 - y1 + "px";
      setSel(icons.filter(function (ic) {
        var r = ic.getBoundingClientRect();
        return r.right > x1 && r.left < x2 && r.bottom > y1 && r.top < y2;
      }));
    }
    function up() {
      document.removeEventListener("pointermove", move);
      document.removeEventListener("pointerup", up);
      m.remove();
      if (!started) setSel([]); /* plain click on empty space clears selection */
    }
    document.addEventListener("pointermove", move);
    document.addEventListener("pointerup", up);
  });

  /* ---------- desktop context menu ---------- */
  var ctx = document.getElementById("ctxmenu");
  function closeCtx() { ctx.hidden = true; }
  desktop.addEventListener("contextmenu", function (e) {
    if (e.target.closest(".win")) return;
    e.preventDefault();
    ctx.style.left = Math.min(e.clientX, window.innerWidth - 156) + "px";
    ctx.style.top = Math.min(e.clientY, window.innerHeight - 130) + "px";
    ctx.hidden = false;
    var f = ctx.querySelector(".sm-item");
    if (f) f.focus();
  });
  document.addEventListener("pointerdown", function (e) {
    if (!ctx.hidden && !e.target.closest("#ctxmenu")) closeCtx();
  });
  document.getElementById("ctx-arrange").addEventListener("click", function () {
    arrangeIcons(); closeCtx();
  });
  document.getElementById("ctx-refresh").addEventListener("click", function () {
    closeCtx();
    desktop.classList.add("refresh");
    setTimeout(function () { desktop.classList.remove("refresh"); }, 140);
  });
  document.getElementById("ctx-props").addEventListener("click", function () {
    openWindow("display", ctx); closeCtx();
  });
  ctx.addEventListener("keydown", function (e) {
    var items = Array.prototype.slice.call(ctx.querySelectorAll(".sm-item"));
    var i = items.indexOf(document.activeElement);
    if (e.key === "ArrowDown") { e.preventDefault(); items[(i + 1) % items.length].focus(); }
    else if (e.key === "ArrowUp") { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
  });
  document.getElementById("d-apply").addEventListener("click", function () {
    desktop.classList.add("refresh");
    setTimeout(function () { desktop.classList.remove("refresh"); }, 140);
  });

  /* ---------- start menu ---------- */
  var startbtn = document.getElementById("startbtn");
  var startmenu = document.getElementById("startmenu");
  var shutdown = document.getElementById("shutdown");

  function closeStart() {
    startmenu.hidden = true;
    startbtn.classList.remove("pressed");
    startbtn.setAttribute("aria-expanded", "false");
  }
  startbtn.addEventListener("click", function (e) {
    e.stopPropagation();
    var show = startmenu.hidden;
    closeStart();
    if (show) {
      startmenu.hidden = false;
      startbtn.classList.add("pressed");
      startbtn.setAttribute("aria-expanded", "true");
      var first = startmenu.querySelector(".sm-item");
      if (first) first.focus();
    }
  });
  document.addEventListener("pointerdown", function (e) {
    if (!startmenu.hidden && !e.target.closest("#startmenu") && !e.target.closest("#startbtn")) closeStart();
  });
  startmenu.addEventListener("keydown", function (e) {
    var items = Array.prototype.slice.call(startmenu.querySelectorAll(".sm-item"));
    var i = items.indexOf(document.activeElement);
    if (e.key === "ArrowDown") { e.preventDefault(); items[(i + 1) % items.length].focus(); }
    else if (e.key === "ArrowUp") { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
  });
  document.getElementById("sm-shutdown").addEventListener("click", function () {
    closeStart();
    shutdown.hidden = false;
  });
  function revive() { shutdown.hidden = true; }
  shutdown.addEventListener("click", revive);
  document.addEventListener("keydown", function (e) {
    if (!shutdown.hidden) { revive(); return; }
    if (e.ctrlKey && e.key === "Escape") { e.preventDefault(); startbtn.click(); return; }
    if (e.key === "Escape") { closeStart(); closeCtx(); return; }
    if (e.altKey && e.key === "Tab") {
      e.preventDefault();
      var ids = Object.keys(openWins).filter(function (id) {
        return !openWins[id].el.classList.contains("min");
      });
      if (!ids.length) return;
      focusWindow(ids[(ids.indexOf(activeId) + 1) % ids.length]);
    }
  });

  /* ---------- clock ---------- */
  var clock = document.getElementById("clock");
  function tick() {
    var d = new Date();
    clock.textContent = d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
    clock.title = d.toLocaleDateString([], { weekday: "long", year: "numeric", month: "long", day: "numeric" });
  }
  tick();
  setInterval(tick, 1000);

  /* ---------- boot ---------- */
  openWindow("welcome", document.querySelector('.icon[data-win="welcome"]'));
})();
</script>
</body>
</html>
