---
import atlas from '../../game/data/atlas.json';
if (!import.meta.env.DEV) return Astro.redirect(import.meta.env.BASE_URL);
const base = import.meta.env.BASE_URL;
---
<html lang="en"><head><title>Development atlas inspection</title></head><body>
<h1>Atlas / development only</h1><p>Source-only legends are excluded. Inspect all frames before accepting a clip.</p>
<div id="sprites" data-base={base}></div>
<script is:inline define:vars={{atlas,base}}>
 const root=document.getElementById('sprites');
 function entry(label,path,w,h){const figure=document.createElement('figure');const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;canvas.style.width=w*3+'px';canvas.style.height=h*3+'px';const caption=document.createElement('figcaption');caption.textContent=label;figure.append(canvas,caption);root.append(figure);const img=new Image();img.src=base+'assets/'+path;return {canvas,img};}
 for(const [name,f] of Object.entries(atlas.frames)){const [x,y,w,h]=f.rect;const {canvas,img}=entry(name,atlas.textures[f.texture],w,h);img.onload=()=>canvas.getContext('2d').drawImage(img,x,y,w,h,0,0,w,h);}
 for(const texture of atlas.cats.textures)for(const [name,c] of Object.entries(atlas.cats.clips)){const {canvas,img}=entry(texture+' / '+name,'cats/'+texture+'.png',32,32);let frame=0;img.onload=()=>{const draw=()=>{const ctx=canvas.getContext('2d');ctx.clearRect(0,0,32,32);ctx.drawImage(img,((c.start||0)+frame)*32,c.row*32,32,32,0,0,32,32);frame=(frame+1)%c.count};draw();setInterval(draw,c.duration);};}
</script>
<style is:global>body{background:#222;color:#eee;font:14px monospace}#sprites{display:flex;flex-wrap:wrap;gap:12px}figure{margin:0;padding:10px;border:1px solid #666}canvas{image-rendering:pixelated;background:repeating-conic-gradient(#555 0% 25%,#888 0% 50%) 0/16px 16px}figcaption{margin-top:8px}</style>
</body></html>
